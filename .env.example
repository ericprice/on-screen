# Public client configuration, bundled by every Xcode app build.
# Copy this file to .env or set these values in the build environment.
# Build environment values override .env. Quotes and export are supported;
# shell commands and variable interpolation are never evaluated.
# Use the project's public phc_ token, never a personal or secret API key.
POSTHOG_PROJECT_TOKEN=phc_replace_with_your_public_project_token
# Choose your project's ingestion origin (US, EU, or self-hosted).
POSTHOG_HOST=https://us.i.posthog.com

# Analytics classification is intentionally never read from .env.
# Ordinary Xcode builds, including Release, default to development + internal=true.
# The local build script also accepts ON_SCREEN_ANALYTICS_ENVIRONMENT=test in its
# process environment. All development/test builds must remain internal=true.
# script/package_zip.sh explicitly builds production + internal=false and validates
# a hardened, Developer ID signed Release archive. Set neither key in this file.
